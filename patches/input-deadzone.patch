+// Normalize one signed SDL axis to the [-1, 1] contract expected by libultra.
+// Current N64ModernRuntime exposes get_input but no apply_stick_deadzone helper.
+static float stadiumfei_stick_axis(int32_t value, int32_t deadzone) {
+    const int32_t magnitude = value < 0 ? -value : value;
+    if (magnitude <= deadzone) return 0.0f;
+    const int32_t maximum = value < 0 ? 32768 : 32767;
+    const float normalized = float(magnitude - deadzone) / float(maximum - deadzone);
+    return value < 0 ? -normalized : normalized;
+}
